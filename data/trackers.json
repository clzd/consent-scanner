  "cookies": [
    { "pattern": "^_ga(_.+)?$",                       "company": "Google",    "service": "Google Analytics",       "category": "analytics" },
    { "pattern": "^_gid$",                            "company": "Google",    "service": "Google Analytics",       "category": "analytics" },
    { "pattern": "^_gat(_.+)?$",                      "company": "Google",    "service": "Google Analytics",       "category": "analytics" },
    { "pattern": "^_gcl_(au|aw|dc|gb|gs)$",           "company": "Google",    "service": "Google Ads",             "category": "advertising" },
    { "pattern": "^(IDE|DSID|test_cookie)$",          "company": "Google",    "service": "Google Marketing Platform (DoubleClick)", "category": "advertising" },
    { "pattern": "^_fbp$",                            "company": "Meta",      "service": "Meta Pixel",             "category": "advertising" },
    { "pattern": "^_fbc$",                            "company": "Meta",      "service": "Meta Pixel",             "category": "advertising" },
    { "pattern": "^_uet(sid|vid)$",                   "company": "Microsoft", "service": "Microsoft Advertising",  "category": "advertising" },
    { "pattern": "^MUID$",                            "company": "Microsoft", "service": "Microsoft Advertising",  "category": "advertising" },
    { "pattern": "^_cl(ck|sk)$",                      "company": "Microsoft", "service": "Microsoft Clarity",      "category": "session-replay" },
    { "pattern": "^_hj",                              "company": "Hotjar",    "service": "Hotjar",                 "category": "session-replay" },
    { "pattern": "^_tt(p|_enable_cookie)$",           "company": "TikTok",    "service": "TikTok Pixel",           "category": "advertising" },
    { "pattern": "^_(pin_unauth|derived_epik)$",      "company": "Pinterest", "service": "Pinterest Tag",          "category": "advertising" },
    { "pattern": "^(li_sugr|li_fat_id|bcookie|lidc)$","company": "LinkedIn",  "service": "LinkedIn Insight Tag",   "category": "advertising" },
    { "pattern": "^_scid$",                           "company": "Snap",      "service": "Snap Pixel",             "category": "advertising" },
    { "pattern": "^_rdt_uuid$",                       "company": "Reddit",    "service": "Reddit Pixel",           "category": "advertising" },
    { "pattern": "^cto_bundle$",                      "company": "Criteo",    "service": "Criteo",                 "category": "advertising" },
    { "pattern": "^uuid2$",                           "company": "Microsoft", "service": "Xandr",                  "category": "advertising" },
    { "pattern": "^__qca$",                           "company": "Quantcast", "service": "Quantcast Measure",      "category": "analytics" },
    { "pattern": "^(__hstc|hubspotutk)$",             "company": "HubSpot",   "service": "HubSpot Analytics",      "category": "analytics" },
    { "pattern": "^ajs_(anonymous_id|user_id)$",      "company": "Twilio",    "service": "Segment",                "category": "analytics" },
    { "pattern": "^mp_.+_mixpanel$",                  "company": "Mixpanel",  "service": "Mixpanel",               "category": "analytics" },
    { "pattern": "^AMP_",                             "company": "Amplitude", "service": "Amplitude",              "category": "analytics" },
    { "pattern": "^_pk_(id|ses)\\.",                  "company": "Matomo",    "service": "Matomo",                 "category": "analytics" },
    { "pattern": "^(s_cc|s_sq|s_vi|s_fid|s_ecid)$",   "company": "Adobe",     "service": "Adobe Analytics",        "category": "analytics" },
    { "pattern": "^AMCV_",                            "company": "Adobe",     "service": "Adobe Experience Cloud", "category": "analytics" }
  ]
}
